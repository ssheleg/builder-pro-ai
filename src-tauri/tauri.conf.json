{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Builder Pro AI",
  "version": "0.10.6",
  "identifier": "ai.builderpro.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Builder Pro AI",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost http://localhost:5173 ws://localhost:5173",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "font-src": "'self'",
        "style-src": "'self' 'unsafe-inline'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "externalBin": ["binaries/bpa-sessiond", "binaries/bpa-orchd"],
    "macOS": {
      "entitlements": "entitlements.plist",
      "hardenedRuntime": true,
      "minimumSystemVersion": "12.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc2ODJEMjEzNTU2RTZCMTIKUldRU2EyNVZFOUtDZGtQUEdKWHFuQVZqZWJLdVlEa0k0OHRVTXIxNTI1QklhM2VOSnNSZVhSMHcK",
      "endpoints": [
        "https://github.com/ssheleg/builder-pro-ai/releases/latest/download/latest.json"
      ],
      "dialog": false
    }
  }
}
