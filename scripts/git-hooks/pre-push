#!/usr/bin/env bash
# pre-push guard for `main` (docs/branching.md rule 1). GitHub server-side branch protection is
# unavailable on this private repo's plan (needs GitHub Pro or a public repo), so this hook is the
# local equivalent: it refuses the two irreversible mistakes on `main` — a force (history-rewriting)
# push and a branch deletion. A normal fast-forward push to `main` (the nightbuild -> main release
# merge) is allowed. Install with `bash scripts/setup-git-hooks.sh`.
set -euo pipefail

PROTECTED="main"

is_zero() { [[ "$1" =~ ^0+$ ]]; } # all-zero sha = create (new ref) or, as local_sha, a delete

while read -r local_ref local_sha remote_ref remote_sha; do
  branch="${remote_ref#refs/heads/}"
  [ "$branch" = "$PROTECTED" ] || continue

  # Deleting main (`git push origin :main` / `--delete`) → local_sha is all zeros.
  if is_zero "$local_sha"; then
    echo "pre-push: refusing to DELETE '$PROTECTED' — it is release-only. (docs/branching.md)" >&2
    exit 1
  fi

  # Non-fast-forward (force) push: the remote tip is not an ancestor of what you're pushing.
  if ! is_zero "$remote_sha"; then
    if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
      echo "pre-push: refusing NON-FAST-FORWARD (force) push to '$PROTECTED'." >&2
      echo "  main history is never rewritten. Merge nightbuild -> main and push a fast-forward." >&2
      exit 1
    fi
  fi
done

exit 0
